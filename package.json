{
  "name": "ihiga-lite-site",
  "private": true,
  "version": "0.1.0",
  "description": "Ihiga Lite — a crop advisory chatbot for Rwandan farmers. pnpm workspace monorepo.",
  "scripts": {
    "dev": "pnpm --filter @ihiga-lite/shared build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @ihiga-lite/shared build && pnpm --recursive --filter \"./apps/*\" build",
    "lint": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "axios": "^1.16.0",
      "uuid": "^11.1.1",
      "lodash": "^4.18.0",
      "qs": "^6.15.2",
      "joi": "^18.2.1",
      "@angular-devkit/core>picomatch": "^4.0.4",
      "tmp": "^0.2.6",
      "webpack": "^5.104.1",
      "postcss": "^8.5.10"
    }
  }
}
