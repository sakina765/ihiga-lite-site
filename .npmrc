# Render (and similar platforms) expose the service's NODE_ENV=production
# env var during the INSTALL step too, not just at runtime — and pnpm, like
# npm, skips devDependencies entirely when NODE_ENV=production is set at
# install time. That silently drops @nestjs/cli (needed to run `nest build`)
# and typescript (needed to run `tsc`), breaking the build with a
# "command not found" error despite pnpm-lock.yaml being fine. This forces
# devDependencies to always install regardless of NODE_ENV — confirmed
# locally: without this, `nest`/`tsc` are missing from node_modules/.bin
# under NODE_ENV=production; with it, they're present and the build succeeds.
production=false
