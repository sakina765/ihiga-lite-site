# PostgreSQL connection string (Supabase-compatible)
DATABASE_URL=postgresql://user:password@localhost:5432/ihiga_lite
# Set to "true" when connecting to a provider that requires SSL (e.g. Supabase)
DATABASE_SSL=false
# Leave "false" — schema is managed by TypeORM migrations (see
# src/database/migrations/), which run automatically on boot. Only set to
# "true" for quick local prototyping of a new entity before generating a
# migration for it.
DATABASE_SYNCHRONIZE=false

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
# Set to "production" on the deployed API — this also unmounts /debug/* (see
# src/debug/), which must never be reachable in production.
NODE_ENV=development

# Groq (OpenAI-compatible API) — required by GroqService / the chat orchestrator.
# Get a key from https://console.groq.com -> API Keys
GROQ_API_KEY=

# Africa's Talking SMS — used by SmsService for stage-change/weather-risk
# notifications. Get sandbox or production credentials from
# https://account.africastalking.com. If left blank, sendSms() logs a
# masked-number skip notice and returns without sending (no crash).
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
