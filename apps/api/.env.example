# PostgreSQL connection string (Supabase-compatible)
DATABASE_URL=postgresql://user:password@localhost:5432/ihiga_lite
# Set to "true" when connecting to a provider that requires SSL (e.g. Supabase)
DATABASE_SSL=false
# Set to "true" only in local dev to auto-sync TypeORM entities to the schema
DATABASE_SYNCHRONIZE=false

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Groq (OpenAI-compatible API) — required by GroqService / the chat orchestrator.
# Get a key from https://console.groq.com -> API Keys
GROQ_API_KEY=

# Africa's Talking SMS — used by SmsService (not yet implemented)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
